# Server Configuration
PORT=3000

# Session Secret - Change this to a random string in production
SESSION_SECRET=your-secret-key-here

# Database Configuration
# For local development: postgresql://username:password@localhost:5432/database_name
# For Render: Set DATABASE_URL in Render dashboard (provided automatically)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/link_db

# Admin Account Configuration (optional - defaults will be used if not set)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123456-to-a-random-string
